{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": false,
    "outDir": "dist/linux",
    "rootDir": "src",
    "types": ["node", "@cloudflare/workers-types"],
    "skipLibCheck": true
  },
  "include": [
    "src/linux-server.ts",
    "src/worker/**/*",
    "src/lib/**/*",
    "src/auth/**/*",
    "src/framework/**/*",
    "src/routes/**/*",
    "src/pieces/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/admin",
    "src/ghpages",
    "src/cli"
  ]
}
